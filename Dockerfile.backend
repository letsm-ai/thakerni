# ============================================================
# Letsm AI - Backend (FastAPI + Python 3.11)
# ============================================================
FROM python:3.11-slim AS base

# System deps required by some Python libs (cryptography, pillow, jq)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libjq1 \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer caching)
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r /app/requirements.txt \
 && pip install --no-cache-dir emergentintegrations --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/

# Copy backend source
COPY backend/ /app/

# Create non-root user
RUN useradd --create-home --shell /bin/bash app \
 && chown -R app:app /app
USER app

EXPOSE 8001

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:8001/api/health || exit 1

# 4 uvicorn workers for 4-core VPS
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips=*"]
