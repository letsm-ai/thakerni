# ============================================================
# Backup script credentials (Backblaze B2 + Mongo)
# Copy to /opt/letsm/.env.backup on the VPS
# ============================================================

# ---- Mongo (same as docker-compose) ----
MONGO_ROOT_USER=letsm_admin
MONGO_ROOT_PASSWORD=__same_as_.env__
DB_NAME=letsm_production

# ---- Backblaze B2 ----
# Get from: https://secure.backblaze.com/app_keys.htm
B2_ACCOUNT_ID=__keyID__
B2_APP_KEY=__applicationKey__
B2_BUCKET=letsm-backups

# ---- Retention ----
RETENTION_LOCAL_DAYS=3
RETENTION_REMOTE_DAYS=30

# ---- Telegram notifications (optional) ----
# Create bot via @BotFather, get chat ID from @userinfobot
TG_BOT_TOKEN=
TG_CHAT_ID=
