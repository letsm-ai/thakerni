# ============================================================
# Letsm AI - WhatsApp Service (Node.js + Baileys)
# ============================================================
FROM node:20-alpine

# Baileys needs git for some optional native deps & curl for healthcheck
RUN apk add --no-cache git curl

# Rewrite SSH GitHub URLs to HTTPS so transitive git dependencies of Baileys
# (e.g. whiskeysockets/libsignal-node) install without an SSH key.
# `--add` is critical: without it, each line replaces the previous one and only
# the last rewrite rule survives.
RUN git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
 && git config --global --add url."https://github.com/".insteadOf "git@github.com:" \
 && git config --global --add url."https://github.com/".insteadOf "git+ssh://git@github.com/" \
 && git config --global --get-all url."https://github.com/".insteadOf

WORKDIR /app

# Install deps first (layer caching)
COPY whatsapp-service/package.json whatsapp-service/yarn.lock* /app/
RUN yarn install --production --network-timeout 600000

# Copy source
COPY whatsapp-service/ /app/

# Persistent auth folder (mounted as volume in compose)
RUN mkdir -p /app/auth_info && chown -R node:node /app
USER node

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:3001/health || exit 1

CMD ["node", "index.js"]
