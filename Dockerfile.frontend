# ============================================================
# Letsm AI - Frontend (React + CRACO) - Multi-stage build
# ============================================================

# ---- Stage 1: build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (layer caching)
COPY frontend/package.json frontend/yarn.lock /app/
# Use --network-timeout for slow registries. We removed --frozen-lockfile so
# that small lockfile drifts (e.g. when a new dep was added on dev but lockfile
# wasn't fully committed) don't break production builds.
RUN yarn install --network-timeout 600000 --non-interactive

# Copy sources & build
COPY frontend/ /app/

# REACT_APP_* envs are baked at build time
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
ARG REACT_APP_GOOGLE_CLIENT_ID
ENV REACT_APP_GOOGLE_CLIENT_ID=${REACT_APP_GOOGLE_CLIENT_ID}

RUN yarn build

# ---- Stage 2: nginx serving static files ----
FROM nginx:1.27-alpine AS runtime

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our static-only frontend config
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
