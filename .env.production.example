# ============================================================
# Letsm AI - Production Environment Variables (TEMPLATE)
# Copy to /opt/letsm/.env and FILL ALL VALUES before `docker compose up`
# ============================================================

# ---- Domain & URLs ----
DOMAIN=letsm.ai
REACT_APP_BACKEND_URL=https://letsm.ai
CORS_ORIGINS=https://letsm.ai,https://www.letsm.ai
GOOGLE_REDIRECT_URI=https://letsm.ai/api/calendar/google/callback
TZ=Asia/Muscat

# ---- MongoDB (local in Docker) ----
MONGO_ROOT_USER=letsm_admin
MONGO_ROOT_PASSWORD=__CHANGE_ME_strong_random_32_chars__
DB_NAME=letsm_production

# ---- Redis ----
REDIS_PASSWORD=__CHANGE_ME_strong_random_32_chars__

# ---- JWT ----
JWT_SECRET_KEY=__CHANGE_ME_run_openssl_rand_hex_64__

# ---- AI (Emergent Universal LLM Key) ----
EMERGENT_LLM_KEY=sk-emergent-...

# ---- Stripe (live keys for production) ----
STRIPE_API_KEY=sk_live_...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
SENDER_EMAIL=noreply@letsm.ai

# ---- Google OAuth (Calendar sync) ----
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# ---- Mongo Express UI (DB admin) ----
# Basic-auth credentials for the http://localhost:8081 panel (via SSH tunnel)
ME_USER=admin
ME_PASSWORD=__CHANGE_ME_strong_random__
